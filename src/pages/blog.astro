---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "My Astro Learning page";
---

<BaseLayout pageTitle={pageTitle}>
  <h2>... c'est génial!</h2>

  <p>La laine mérinos est une fibre naturelle provenant de la toison des moutons mérinos. Elle est réputée pour sa douceur, sa légèreté et ses propriétés thermorégulatrices, ce qui en fait un choix populaire pour les vêtements et les accessoires.</p>

  <ul>
        {allPosts.map((post: any) => <BlogPost title={post.frontmatter.title} url={post.url} />)}
  </ul>
</BaseLayout>
