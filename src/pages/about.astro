---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Qui suis-je ?";

const identity = {
  firstName: "Nicolas",
  country: "France",
  city: "Lille",
  occupation: "ingénieur dans le secteur de l'énergie",
  hobbies: ["les sciences", "la lecture", "le vélo"],
};

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---

<BaseLayout pageTitle={pageTitle}>
    <body>
        <style is:global define:vars={{skillColor, fontWeight, textCase}}>
        h1 {
            color: purple;
            font-size: 4rem;
        }

        </style>
                <h2>... et pourquoi je fais un site sur le mérinos ?</h2>

                <p>Au bas mot, cette matière est l'un de mes meilleurs investissements (à égalité avec l'achat d'un bon matelas). Ainsi j'aimerais la faire découvrir à d'autres personnes.</p>

                <p>Je souhaite que ce site détaille les avantages du mérinos et raconte comment ce matériau a transformé (amélioré) mon confort, en été comme en hiver.</p>
                  
                <p>Voici quelques informations me concernant:</p>
                <ul>
                <li>Je m'appelle {identity.firstName}. J'ai <span id="age"></span> ans.</li>
                <li>Je vis en {identity.country}, à {identity.city}, et je travaille comme {identity.occupation}.</li>
                {identity.hobbies.length >= 3 &&
                    <li>J'aime {identity.hobbies[0]}, {identity.hobbies[1]}, {identity.hobbies[2]}... Aussi dîner entre amis et en famille, et avec ma petite amie (qui m'a obligé à écrire cela). Assez classique :)</li>
                }
                </ul>
            
        <script>
        const birthDate = new Date(1993, 7, 8);

        function getAge(dateOfBirth) {
            const today = new Date();

            let age = today.getFullYear() - dateOfBirth.getFullYear();

            const hasHadBirthday =
            today.getMonth() > dateOfBirth.getMonth() ||
            (today.getMonth() === dateOfBirth.getMonth() &&
                today.getDate() >= dateOfBirth.getDate());

            if (!hasHadBirthday) {
            age--;
            }

            return age;
        }

        document.querySelector("#age").textContent = getAge(birthDate);
        </script>

        </body>
    </BaseLayout>